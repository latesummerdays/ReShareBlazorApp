@page "/register"
@using ReShareBlazorApp.Models

<EditForm Model="@registerModel" OnInvalidSubmit="Register">
    <DataAnnotationsValidator></DataAnnotationsValidator>
    <div class="register-container">
    <div class="register-card">
            <h2>Utwórz Konto</h2>
            <p>Wypełnij formularz, aby się zarejestrować</p>
            <div class="register-field">
                <div class="register-field">
                    <label>Nazwa użytkownika</label>
                    <InputText @bind-Value="registerModel.Username" class="register-input" placeholder="Wpisz nazwe uzytkownika"/>
                    <ValidationMessage For="@(() => registerModel.Username)"/>
                </div>
                <div class="register-field">
                    <label>E-Mail</label>
                    <InputText @bind-Value="registerModel.Email" class="register-input" placeholder="Wpisz Email"/>
                    <ValidationMessage For="@(() => registerModel.Email)"/>
                </div>
                <div class="register-field">
                    <label>Hasło</label>
                    <InputText @bind-Value="registerModel.Password" class="register-input" placeholder="Wpisz Hasło"/>
                    <ValidationMessage For="@(() => registerModel.Password)"/>
                </div>
                <div class="register-field">
                <label>Potwierdź Hasło</label>
                    <InputText @bind-Value="registerModel.ConfirmPassword" class="register-input" placeholder="Wpisz Hasło"/>
                    <ValidationMessage For="@(() => registerModel.ConfirmPassword)" />
                </div>
                <div class="register-terms">
                    <InputCheckbox @bind-Value="registerModel.AcceptTerms"/>
                    <label>Akceptuje regulamin.</label>
                </div>
                <ValidationMessage For="@(() => registerModel.AcceptTerms)"/>
                <button type="submit" class="register-button"> Zarejestruj się</button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    private RegisterModel registerModel = new RegisterModel();
    private async Task Register()
    {

    }
}
