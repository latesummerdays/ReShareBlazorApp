@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

<nav class="main-navbar">
    <div class="navbar-container">

        <a href="/" class="navbar-brand">
            <span class="brand-icon">r:</span>
            <span class="brand-name">reshare</span>
        </a>

        <form class="navbar-search" action="/discover" method="get">
            <span class="search-icon">⌕</span>
            <input type="search"
                   name="q"
                   placeholder="Czego szukasz?"
                   aria-label="Szukaj produktów" />
            <button type="submit">Szukaj</button>
        </form>

        <div class="navbar-links">
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-link">
                Strona główna
            </NavLink>

            <NavLink href="/discover" class="nav-link">
                Odkrywaj
            </NavLink>

            <AuthorizeView>
                <Authorized>
                    <NavLink href="/messages" class="nav-link">
                        Wiadomości
                    </NavLink>

                    <NavLink href="/profile" class="nav-link">
                        Profil
                    </NavLink>

                    <a href="/add-product" class="nav-add-button">
                        + Dodaj produkt
                    </a>
                </Authorized>

                <NotAuthorized>
                    <NavLink href="/login" class="nav-link">
                        Zaloguj się
                    </NavLink>

                    <NavLink href="/register" class="nav-register-button">
                        Załóż konto
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>

    </div>
</nav>
