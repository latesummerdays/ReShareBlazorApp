@page "/discover"

<PageTitle>Odkrywaj | reShare</PageTitle>

<div class="page-container">
    <div class="page-header">
        <span class="eyebrow">Przegląd ofert</span>
        <h1>Odkrywaj bilety i okazje</h1>
        <p>Wszystkie aktualne ogłoszenia dodane przez społeczność.</p>
    </div>

    <div class="products-grid">
        <div class="product-card">
            <span class="product-badge">Wygasa za 3h</span>
            <div class="product-image-placeholder">Podgląd</div>
            <div class="product-details">
                <span class="product-category">Bilety</span>
                <h3 class="product-title">Nazwa ogłoszenia</h3>
                <div class="product-footer">
                    <span class="product-price">50 PLN</span>
                    <button class="btn-buy-sm">Zobacz</button>
                </div>
            </div>
        </div>
    </div>
</div>