@page "/add-product"

<PageTitle>Dodaj Produkt | reShare</PageTitle>

<div class="page-container">
    <div class="form-card">
        <div class="auth-heading">
            <span class="eyebrow">Nowe ogłoszenie</span>
            <h1>Wystaw bilet lub przedmiot</h1>
            <p>Uzupełnij szczegóły, aby szybko znaleźć kupca.</p>
        </div>
        
        <EditForm Model="@productModel">
            <div class="form-group">
                <label for="title">Tytuł ogłoszenia</label>
                <input id="title" class="form-control" placeholder="np. Bilet na koncert" />
            </div>

            <div class="form-group">
                <label for="price">Cena (PLN)</label>
                <input id="price" type="number" class="form-control" placeholder="0.00" />
            </div>

            <div class="form-group">
                <label for="description">Opis</label>
                <textarea id="description" class="form-control" placeholder="Opisz szczegóły, termin oraz sposób przekazania..."></textarea>
            </div>

            <button type="submit" class="btn-primary auth-submit">Opublikuj ogłoszenie</button>
        </EditForm>
    </div>
</div>

@code {
    private object productModel = new();
}