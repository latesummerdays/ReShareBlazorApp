@page "/profile"

<PageTitle>Profil | reShare</PageTitle>

<div class="page-container">
    <div class="profile-header">
        <div class="profile-avatar">JK</div>
        <div class="profile-info">
            <h1>Jan Kowalski</h1>
            <p>Konto zweryfikowane</p>
            <div class="profile-stats">
                <div class="stat-item">Aktywne: <strong>1</strong></div>
                <div class="stat-item">Sprzedane: <strong>0</strong></div>
            </div>
        </div>
    </div>

    <div class="section-title-wrapper">
        <div>
            <h2 class="section-title">Twoje aktywne ogłoszenia</h2>
        </div>
    </div>

    <div class="products-grid">
        <div class="product-card">
            <span class="product-badge">Aktywne</span>
            <div class="product-image-placeholder">Podgląd</div>
            <div class="product-details">
                <span class="product-category">Bilety</span>
                <h3 class="product-title">Twoje dodane ogłoszenie</h3>
                <div class="product-footer">
                    <span class="product-price">30 PLN</span>
                    <button class="btn-secondary-sm">Edytuj</button>
                </div>
            </div>
        </div>
    </div>
</div>